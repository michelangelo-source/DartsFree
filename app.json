{
  "expo": {
    "name": "DartsFree",
    "slug": "DartsFree",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dartsfree",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#dad6d5",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gacekt.DartsFree"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fullDart.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fullDart.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EBEBEB",
          "dark": {
            "backgroundColor": "#EBEBEB"
          }
        }
      ],
      "expo-web-browser",
      "expo-build-properties",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
